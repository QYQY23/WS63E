choice
    prompt "SLE Sample"

config SAMPLE_SUPPORT_SLE_SPEED_SERVER_SAMPLE
    bool "Support SLE Throughput Server Sample."

config LARGE_THROUGHPUT_SERVER
    bool "server large throughput."
    default y
    depends on SAMPLE_SUPPORT_SLE_SPEED_SERVER_SAMPLE

config SAMPLE_SUPPORT_SLE_SPEED_CLIENT_SAMPLE
    bool "Support SLE Throughput Client Sample."

config LARGE_THROUGHPUT_CLIENT
    bool "client large throughput."
    default y
    depends on SAMPLE_SUPPORT_SLE_SPEED_CLIENT_SAMPLE

config SAMPLE_SUPPORT_SLE_IDENTITY_SERVER_SAMPLE
    bool "Support SLE Identity Server Sample."

config SAMPLE_SUPPORT_SLE_IDENTITY_CLIENT_SAMPLE
    bool "Support SLE Identity Client Sample."

endchoice

config SUPPORT_SLE_PERIPHERAL
    bool
    default y if (SAMPLE_SUPPORT_SLE_SPEED_SERVER_SAMPLE || SAMPLE_SUPPORT_SLE_IDENTITY_SERVER_SAMPLE)

config SUPPORT_SLE_CENTRAL
    bool
    default y if (SAMPLE_SUPPORT_SLE_SPEED_CLIENT_SAMPLE || SAMPLE_SUPPORT_SLE_IDENTITY_CLIENT_SAMPLE)
